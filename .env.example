# --- Server -------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- PostgreSQL ---------------------------------------------------------
# Either a full connection string...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nestara
# ...or the discrete parts (used only when DATABASE_URL is empty).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=nestara
PGSSL=false
PG_POOL_MAX=10

# --- Auto migration -----------------------------------------------------
# Run the schema reconciler on boot (creates missing tables/columns/indexes).
AUTO_MIGRATE=true
# Repair the schema on the fly when a request hits a missing column/table.
AUTO_HEAL=true
# Load db/seed.sql style demo data once, when the database is empty.
AUTO_SEED=false

# --- Auth ---------------------------------------------------------------
JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# --- Logging ------------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true
# Directory for rotating request/error log files ("" disables file logging).
LOG_DIR=logs

# --- Branding (used in emails and Stripe metadata) -----------------------
APP_NAME=RoomEasy
APP_PUBLIC_URL=https://www.your-domain.com

# --- Email / SMTP (OVH) --------------------------------------------------
# OVH MX Plan / Email Pro / Exchange: ssl0.ovh.net
#   port 465 with SMTP_SECURE=true (implicit TLS)  -- recommended
#   port 587 with SMTP_SECURE=false (STARTTLS)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
# The full mailbox address created in the OVH control panel, plus its password.
SMTP_USER=no-reply@your-domain.com
SMTP_PASSWORD=
# Visible sender. Leave MAIL_FROM_ADDRESS empty to reuse SMTP_USER.
MAIL_FROM_NAME=RoomEasy
MAIL_FROM_ADDRESS=no-reply@your-domain.com
MAIL_REPLY_TO=support@your-domain.com
# true = render and log emails without sending them (safe for development).
MAIL_DRY_RUN=false
# Background worker that drains the notification queue.
MAIL_WORKER=true
MAIL_POLL_SECONDS=30
MAIL_BATCH_SIZE=20
MAIL_MAX_ATTEMPTS=5

# --- Stripe --------------------------------------------------------------
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Dashboard > Developers > Webhooks > add endpoint
#   URL    https://<your-api-domain>/api/payments/webhook
#   events payment_intent.succeeded, payment_intent.payment_failed,
#          charge.refunded, account.updated
STRIPE_WEBHOOK_SECRET=
# Two-letter country for new Connect Express accounts (e.g. FR, TN). Optional.
STRIPE_CONNECT_COUNTRY=
PAYMENT_CURRENCY=EUR

# --- Unpaid booking holds ---------------------------------------------------
# Minutes a pending, unpaid booking keeps its nights before it is cancelled.
BOOKING_HOLD_MINUTES=30
BOOKING_MAINTENANCE=true
BOOKING_MAINTENANCE_SECONDS=120
